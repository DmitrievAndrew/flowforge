# Явно помечаем Rust-код как основной
*.rs linguist-language=Rust
*.toml linguist-language=TOML

# Cargo.lock не должен влиять на статистику языков
Cargo.lock linguist-generated=true -linguist-detectable
consumer-rs/Cargo.lock linguist-generated=true -linguist-detectable

# Скрипты и документация не влияют на статистику
*.md linguist-documentation
*.sh linguist-language=Shell
